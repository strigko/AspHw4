@model List<AspHw4.Models.Category>

<h2>Categories</h2>

<a asp-action="Create" class="btn btn-primary mb-3">
    Add Category
</a>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td>
            </tr>
        }
    </tbody>
</table>